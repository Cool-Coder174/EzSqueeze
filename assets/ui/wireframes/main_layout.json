{
  "wireframe": {
    "version": "1.0.0",
    "name": "EzSqueeze Main Interface",
    "dimensions": {
      "width": 900,
      "height": 650,
      "scalable": true,
      "scaleRange": [0.9, 1.3]
    },
    "theme": {
      "name": "Citrus Liquid Glass",
      "colors": {
        "primary": "#EF932C",
        "primaryLight": "#F1B233",
        "primaryDark": "#DA761E",
        "accent": "#EE811C",
        "accentAlt": "#E78826",
        "warning": "#C75B13",
        "highlight": "#F3C16A",
        "background": "#1A1A1D",
        "panelBg": "#252528",
        "glass": "rgba(255, 255, 255, 0.08)",
        "glassBorder": "rgba(239, 147, 44, 0.3)",
        "text": "#E0E0E0",
        "textDim": "#909090",
        "meterGreen": "#4CAF50",
        "meterYellow": "#FFC107",
        "meterRed": "#F44336",
        "meterBg": "#2A2A2D"
      },
      "gradients": {
        "glass": "linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%)",
        "knob": "radial-gradient(circle at 30% 30%, #F1B233, #EF932C, #DA761E)"
      },
      "effects": {
        "blur": "12px",
        "shadow": "0 8px 32px rgba(0, 0, 0, 0.4)",
        "glow": "0 0 20px rgba(239, 147, 44, 0.5)"
      }
    },
    "layout": {
      "header": {
        "y": 0,
        "height": 60,
        "elements": [
          {"type": "logo", "x": 20, "y": 10, "text": "SQUEEZE", "font": "Aderoy", "fontSize": 42, "color": "primary"},
          {"type": "tagline", "x": 160, "y": 28, "text": "Citrus Dynamics", "fontSize": 14, "color": "textDim"},
          {"type": "cpuMeter", "x": 700, "y": 15, "width": 80, "height": 30, "label": "CPU"},
          {"type": "oversamplingIndicator", "x": 790, "y": 15, "width": 50, "height": 30, "label": "OS"},
          {"type": "latencyDisplay", "x": 850, "y": 15, "width": 40, "height": 30, "unit": "ms"}
        ]
      },
      "meteringSection": {
        "x": 20,
        "y": 80,
        "width": 180,
        "height": 500,
        "glass": true,
        "elements": [
          {"type": "levelMeter", "id": "inputMeter", "x": 20, "y": 100, "width": 50, "height": 320, "label": "IN", "peakHold": true, "range": [-60, 6]},
          {"type": "levelMeter", "id": "grMeter", "x": 85, "y": 100, "width": 50, "height": 320, "label": "GR", "peakHold": false, "range": [-24, 0], "color": "primary", "historyTrail": true},
          {"type": "levelMeter", "id": "outputMeter", "x": 150, "y": 100, "width": 50, "height": 320, "label": "OUT", "peakHold": true, "range": [-60, 6]},
          {"type": "label", "x": 30, "y": 440, "text": "METERING", "fontSize": 12, "color": "textDim"}
        ]
      },
      "mainControls": {
        "x": 220,
        "y": 80,
        "width": 660,
        "height": 380,
        "glass": true,
        "sections": [
          {
            "name": "compression",
            "y": 0,
            "knobs": [
              {"id": "threshold", "x": 40, "y": 40, "size": 100, "label": "THRESHOLD", "range": [-60, 0], "unit": "dB", "defaultValue": -18, "tooltip": "Level at which compression begins"},
              {"id": "ratio", "x": 160, "y": 40, "size": 100, "label": "RATIO", "range": [1, 32], "unit": ":1", "defaultValue": 4, "tooltip": "Amount of gain reduction applied"},
              {"id": "knee", "x": 280, "y": 40, "size": 80, "label": "KNEE", "values": ["Hard", "Medium", "Soft"], "defaultValue": "Medium", "tooltip": "Transition curve at threshold"},
              {"id": "attack", "x": 400, "y": 40, "size": 90, "label": "ATTACK", "range": [0.1, 100], "unit": "ms", "defaultValue": 5, "tempoSync": true, "tooltip": "How quickly compression responds"},
              {"id": "release", "x": 520, "y": 40, "size": 90, "label": "RELEASE", "range": [10, 1000], "unit": "ms", "defaultValue": 250, "tempoSync": true, "tooltip": "How quickly compression recovers"}
            ]
          },
          {
            "name": "colorAndCharacter",
            "y": 180,
            "elements": [
              {"type": "vibeWheel", "id": "vibeWheel", "x": 40, "y": 200, "size": 120, "label": "VIBE", "range": ["Clean", "Vintage"], "tooltip": "Blend from transparent to colored"},
              {"type": "toggle", "id": "dualStack", "x": 180, "y": 220, "label": "DUAL STACK", "defaultValue": false, "tooltip": "Enable FET+Opto serial compression"},
              {"type": "selector", "id": "impedance", "x": 280, "y": 220, "values": ["Silicon", "Tube", "Transformer"], "label": "CHARACTER", "defaultValue": "Silicon"},
              {"type": "knob", "id": "cloudGain", "x": 420, "y": 200, "size": 80, "label": "CLOUD GAIN", "range": [0, 30], "unit": "dB", "defaultValue": 0, "tooltip": "Clean preamp with character"},
              {"type": "knob", "id": "mix", "x": 530, "y": 200, "size": 80, "label": "MIX", "range": [0, 100], "unit": "%", "defaultValue": 100, "tooltip": "Parallel compression blend"}
            ]
          }
        ]
      },
      "advancedPanel": {
        "x": 220,
        "y": 480,
        "width": 660,
        "height": 90,
        "glass": true,
        "collapsible": true,
        "label": "ADVANCED",
        "elements": [
          {"type": "knob", "id": "lookahead", "x": 20, "y": 20, "size": 60, "label": "LOOKAHEAD", "range": [0, 10], "unit": "ms", "defaultValue": 0},
          {"type": "knob", "id": "stereoLink", "x": 100, "y": 20, "size": 60, "label": "LINK", "range": [0, 100], "unit": "%", "defaultValue": 100},
          {"type": "toggle", "id": "msMode", "x": 180, "y": 30, "label": "M/S", "defaultValue": false},
          {"type": "knob", "id": "scHpf", "x": 240, "y": 20, "size": 60, "label": "SC HPF", "range": [20, 400], "unit": "Hz", "defaultValue": 20},
          {"type": "knob", "id": "scLpf", "x": 320, "y": 20, "size": 60, "label": "SC LPF", "range": [4000, 16000], "unit": "Hz", "defaultValue": 16000},
          {"type": "selector", "id": "oversampling", "x": 400, "y": 30, "values": ["Off", "2×", "4×", "8×"], "label": "OS", "defaultValue": "Off"},
          {"type": "toggle", "id": "autoRelease", "x": 480, "y": 30, "label": "AUTO RELEASE", "defaultValue": false},
          {"type": "toggle", "id": "autoMakeup", "x": 580, "y": 30, "label": "AUTO MAKEUP", "defaultValue": true}
        ]
      },
      "footer": {
        "y": 590,
        "height": 60,
        "elements": [
          {"type": "presetBrowser", "x": 20, "y": 600, "width": 300, "height": 40, "placeholder": "Search presets..."},
          {"type": "buttonGroup", "x": 340, "y": 600, "buttons": [
            {"id": "abCompare", "label": "A/B", "width": 50},
            {"id": "undo", "label": "↶", "width": 40},
            {"id": "redo", "label": "↷", "width": 40}
          ]},
          {"type": "button", "id": "autoSweetSpot", "x": 520, "y": 600, "width": 120, "height": 40, "label": "AUTO SWEET SPOT", "color": "accent"},
          {"type": "presetSelector", "x": 660, "y": 600, "width": 220, "height": 40, "label": "Style Mode"}
        ]
      }
    },
    "accessibility": {
      "tabOrder": [
        "threshold", "ratio", "knee", "attack", "release",
        "vibeWheel", "dualStack", "impedance", "cloudGain", "mix",
        "lookahead", "stereoLink", "msMode", "scHpf", "scLpf",
        "oversampling", "autoRelease", "autoMakeup",
        "presetBrowser", "abCompare", "undo", "redo", "autoSweetSpot"
      ],
      "tooltips": true,
      "contrastRatio": 4.5,
      "focusIndicator": {"color": "primary", "width": 3, "style": "glow"}
    },
    "responsiveness": {
      "breakpoints": [
        {"width": 900, "scale": 1.0},
        {"width": 810, "scale": 0.9},
        {"width": 1170, "scale": 1.3}
      ]
    }
  }
}
