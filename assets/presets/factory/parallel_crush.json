{
  "name": "Parallel Crush",
  "category": "Creative",
  "author": "EzSqueeze",
  "tags": ["parallel", "crush", "heavy", "aggressive", "NY compression"],
  "description": "Heavy parallel compression for adding weight and aggression. Low mix blends the crushed signal under the dry.",
  "parameters": {
    "threshold": -30,
    "ratio": 10,
    "attack": 0.5,
    "release": 50,
    "knee": "Hard",
    "makeup": 0,
    "mix": 40,
    "detector": "Peak",
    "lookahead": 0,
    "stereoLink": 100,
    "msMode": false,
    "scHPF": 20,
    "scLPF": 20000,
    "oversampling": 1,
    "ecoMode": false,
    "autoRelease": false,
    "autoMakeup": false,
    "vibeWheel": 0,
    "dualStack": false,
    "cloudGain": 0,
    "impedance": "Silicon",
    "snap": 50,
    "body": 50,
    "deSnap": 0
  }
}
